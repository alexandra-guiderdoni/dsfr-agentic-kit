              "description": "Texte alternatif, requis ; chaîne vide pour une image décorative (decorative: true en est la forme explicite, facultative)."
            },
            "caption": {
              "type": "string"
            },
            "ratio": {
              "type": "string",
              "pattern": "^[0-9]+x[0-9]+$",
              "description": "Réservé aux images matricielles. Le builder refuse ratio sur SVG pour éviter de rogner les schémas."
            },
            "decorative": {
              "type": "boolean",
              "description": "Image décorative : autorise alt vide."
            }
          }
        },
        {
          "if": {
            "properties": {
              "src": {
                "type": "string",
                "pattern": "\\.[sS][vV][gG](?:[?#].*)?$"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "ratio"
              ]
            },
            "description": "Un SVG ne doit pas déclarer ratio : le schéma doit conserver sa géométrie naturelle."
          }
