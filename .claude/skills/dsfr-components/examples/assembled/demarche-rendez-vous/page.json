    "tools": [
      {"label": "Se connecter", "href": "/connexion"}
    ],
    "search": {"label": "Rechercher"},
    "navigation": [
      {"label": "Accueil", "href": "#intro", "active": true},
      {"label": "Formulaire", "href": "#formulaire"},
