{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalogue de règles DSFR par instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog", "target_version", "status_policy", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog": {"type": "string", "minLength": 1},
    "target_version": {"type": "string", "minLength": 1},
    "status_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detected_not_audited", "pass", "fail", "review"],
      "properties": {
        "detected_not_audited": {"const": "DETECTE_NON_AUDITE"},
        "pass": {"const": "AUCUN_ECART_REGLES_EXECUTEES"},
        "fail": {"const": "ECART_OBSERVE"},
        "review": {"const": "A_CONFIRMER"}
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "component", "selector", "severity", "title", "expected", "expected_html", "source", "recommendation", "verification", "conditions"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^DSFR-[A-Z0-9-]+-[0-9]{3}$"},
          "component": {"type": "string", "minLength": 1},
          "selector": {"type": "string", "minLength": 1},
          "exclude_selector": {"type": "string", "minLength": 1},
          "severity": {"enum": ["Bloquant", "Majeur", "Mineur", "À qualifier"]},
          "version_scope": {"enum": ["TARGET_VERSION", "VERSION_INDEPENDENT"]},
          "title": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "expected_html": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "verification": {"type": "string", "minLength": 1},
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "message"],
              "properties": {
                "type": {"enum": ["tag_in", "attribute_equals", "attribute_non_empty", "attribute_not_values", "ancestor_or_self_attribute", "descendant_min", "descendant_labelled", "one_attribute_non_empty", "aria_reference_exists", "button_or_link_target", "attribute_contains", "descendant_attribute_contains", "descendant_fragment_targets_exist", "referenced_by_control", "referenced_by_attribute", "referenced_by_attribute_or_empty", "tag_semantics", "descendant_text_non_empty", "ancestor_or_self_selector", "attribute_present", "descendant_fragment_targets_exposed", "self_selector", "self_labelled", "descendant_max", "attribute_tokens_contain", "accessible_name_contains", "prohibited"]},
                "message": {"type": "string", "minLength": 1},
                "name": {"type": "string"},
                "value": {"type": "string"},
                "values": {"type": "array", "items": {"type": "string"}},
                "names": {"type": "array", "items": {"type": "string"}},
                "selector": {"type": "string"},
                "min": {"type": "integer"},
                "max": {"type": "integer"},
                "optional": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
