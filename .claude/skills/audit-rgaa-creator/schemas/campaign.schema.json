{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.gouv.fr/schemas/dsfr-agentic-kit/audit-rgaa-campaign.schema.json",
  "title": "Campagne Audit RGAA Creator",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign", "tooling", "sample", "phases", "browser", "limits", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "created_at", "target", "locale", "referential", "profile"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 8},
        "locale": {"const": "fr-FR"},
        "referential": {"const": "RGAA 4.1.2"},
        "profile": {"const": "rgaa-106"}
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kit_root", "ay11_root", "skills_roots"],
      "properties": {
        "kit_root": {"type": "string"},
        "ay11_root": {"type": "string"},
        "skills_roots": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "sample": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "url", "type"],
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-9]{2,3}$"},
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 8},
          "type": {"type": "string", "minLength": 1},
          "authenticated": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "script"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "script": {"type": "string", "minLength": 1},
          "output": {"type": "string"},
          "pages": {"type": "array", "items": {"type": "string", "pattern": "^P[0-9]{2,3}$"}, "uniqueItems": true}
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ay11", "browser_checks", "reports", "tickets"],
      "properties": {
        "ay11": {"type": "boolean"},
        "browser_checks": {"type": "boolean"},
        "rgaa_checks": {"type": "boolean"},
        "dsfr_checks": {"type": "boolean"},
        "reports": {"type": "boolean"},
        "report_capture": {"type": "boolean"},
        "tickets": {"type": "boolean"}
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wait_ms", "timeout_seconds", "tabs_per_page", "screenshots", "form_interactions", "axe"],
      "properties": {
        "wait_ms": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "tabs_per_page": {"type": "integer", "minimum": 1, "maximum": 300},
        "screenshots": {"type": "boolean"},
        "form_interactions": {"type": "boolean"},
        "axe": {"type": "boolean"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticated_scope", "real_screen_reader", "source_code_available"],
      "properties": {
        "authenticated_scope": {"type": "boolean"},
        "real_screen_reader": {"type": "boolean"},
        "source_code_available": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_compliance_rate", "dsfr_claim"],
      "properties": {
        "official_compliance_rate": {"const": false},
        "dsfr_claim": {"enum": ["aucune conformité DSFR globale revendiquée", "aligné DSFR avec limites"]}
      }
    }
  }
}
