{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Constats Audit RGAA Creator",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pages", "status", "title", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "pages": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^P[0-9]{2,3}$"}, "uniqueItems": true},
          "criterion": {"type": "string"},
          "test": {"type": "string"},
          "status": {"enum": ["NC-A", "C-A", "NA-A", "NT", "NOTE", "RECO"]},
          "severity": {"type": "string"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "impact": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "recommendation": {"type": "string"},
          "verification": {"type": "string"}
        }
      }
    }
  }
}
