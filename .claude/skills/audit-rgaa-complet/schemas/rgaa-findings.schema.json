{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qualification humaine des signaux RGAA par instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pages", "rule_id", "criterion", "test", "qualification_status", "comment", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "pages": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^P[0-9]{2,3}$"}, "uniqueItems": true},
          "rule_id": {"type": "string", "pattern": "^RGAA-[A-Z0-9-]+-[0-9]{3}$"},
          "criterion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "test": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "selector": {"type": "string"},
          "signal_id": {"type": "string", "minLength": 1},
          "instance": {"type": "integer", "minimum": 1},
          "state": {"type": "string", "minLength": 1},
          "viewport": {"type": "object", "additionalProperties": false, "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}, "required": ["width", "height"]},
          "evidence_role": {"enum": ["assertion", "state", "inventory", "manual"]},
          "qualification_status": {"enum": ["C_CONFIRMEE", "NC_CONFIRMEE", "NA_CONFIRMEE", "A_RETESTER", "NON_TESTE"]},
          "severity": {"enum": ["Bloquant", "Majeur", "Mineur", "À qualifier"]},
          "comment": {"type": "string", "minLength": 1},
          "impact": {"type": "string"},
          "recommendation": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "reviewed_by": {"type": "string"},
          "reviewed_at": {"type": "string"}
        }
      }
    }
  }
}
